{
  "robot": {
    "backend": "mock_myarm_m750",
    "port": "/dev/null",
    "baudrate": 1000000,
    "power_on": false,
    "fresh_mode": 1,
    "reference_frame": 0,
    "movement_type": 1,
    "end_type": 1,
    "move_speed": 20,
    "coord_mode": 0,
    "blocking_move": true,
    "home_pose_m_rad": [0.3, 0.0, 0.05, 1.57, 0.0, 1.57],
    "open_gripper_on_reset": true,
    "max_step_translation_m": 0.5,
    "max_step_rotation_rad": 0.35,
    "gripper_threshold": 0.5,
    "gripper_sticky_steps": 1,
    "gripper_speed": 50,
    "gripper_open_value": 100,
    "gripper_close_value": 0,
    "gripper_use_value_api": false,
    "reset_sleep_s": 0.0,
    "wait_for_motion": false,
    "wait_timeout_s": 0.0,
    "se3_integration_mode": "bridge_exact",
    "hardware_measured_enabled": true,
    "pivot_source": "hardware_measured",
    "compose_base": "previous_target",
    "clamp_rotation_in_pose": false,
    "periodic_resync_enabled": false,
    "periodic_resync_every_n_steps": 0,
    "periodic_resync_position_threshold_m": 0.03,
    "periodic_resync_rotation_threshold_rad": 0.35,
    "control_period_s": 0.2,
    "post_command_sleep_s": 0.0,
    "hardware_read_settle_s": 0.03,
    "reset_readback_sync": true,
    "neutral_orientation_rpy_rad": [1.57, 0.0, 1.57],
    "proprio_orientation_mode": "relative_to_neutral",
    "debug_print_every_n_steps": 1,
    "workspace": {
      "translation_min_m": [0.15, -0.3, 0.04],
      "translation_max_m": [0.55, 0.3, 0.3],
      "rotation_min_rad": [-1.57, -1.57, -1.57],
      "rotation_max_rad": [1.57, 1.57, 1.57]
    }
  },
  "cameras": {
    "primary": {
      "enabled": true,
      "index": 0,
      "width": 1280,
      "height": 720,
      "fps": 60,
      "fourcc": "MJPG",
      "warmup_frames": 15,
      "buffer_size": 1,
      "convert_rgb": true,
      "crop_top": 0,
      "crop_bottom": 0,
      "crop_left": 0,
      "crop_right": 0,
      "flip_horizontal": false,
      "flip_vertical": false,
      "rotation_deg": 0,
      "stale_timeout_s": 1.0,
      "allow_stale_frames": true
    },
    "wrist": {
      "enabled": true,
      "index": 2,
      "width": 1280,
      "height": 720,
      "fps": 60,
      "fourcc": "MJPG",
      "warmup_frames": 15,
      "buffer_size": 1,
      "convert_rgb": true,
      "crop_top": 0,
      "crop_bottom": 0,
      "crop_left": 0,
      "crop_right": 0,
      "flip_horizontal": false,
      "flip_vertical": false,
      "rotation_deg": 0,
      "stale_timeout_s": 1.0,
      "allow_stale_frames": true
    }
  },
  "rollout": {
    "checkpoint_dir": "./checkpoints/octo-small-1.5-torch",
    "dataset_key": "bridge_dataset",
    "window_size": 2,
    "exec_horizon": 4,
    "use_temporal_ensemble": true,
    "control_rate_hz": 5.0,
    "max_steps": 120,
    "device": "cuda",
    "fp16": true,
    "seed": 0,
    "save_dir": "./artifacts/mock_myarm_eval",
    "show_camera_preview": true,
    "preview_layout": "side_by_side",
    "preview_show_labels": true,
    "preview_show_timestamps": true,
    "preview_max_height": 360,
    "visualize_mock_3d": true,
    "save_mock_plot_path": "./artifacts/mock_myarm_eval/tcp_path.png",
    "terminate_on_truncation": true,
    "enable_debug_logging": true,
    "save_debug_csv_path": "./artifacts/mock_myarm_eval/robot_debug_trace.csv",
    "save_debug_plot_path": "./artifacts/mock_myarm_eval/robot_debug_trace.png"
  }
}
